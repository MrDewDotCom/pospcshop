{
  "name": "pc-shop-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Back-office system for small and medium computer shops in Thailand",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @pcshop/server\" \"npm run dev -w @pcshop/web\"",
    "build": "npm run build -w @pcshop/web && npm run build -w @pcshop/server",
    "start": "node server/dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @pcshop/server",
    "reset-password": "tsx server/scripts/reset-password.ts",
    "seed": "tsx server/scripts/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
